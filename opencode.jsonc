{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {"action": "*", "resource": "inner/*", "effect": "deny"},
    {"action": "*", "resource": "public/media/*", "effect": "deny"},
    {"action": "*", "resource": "src/*.md", "effect": "deny"},
    {"action": "*", "resource": "*..*", "effect": "deny"},

    //patch fix for #9
    {"action": "glob", "resource": "**/*.md", "effect": "deny"},
    {"action": "shell", "resource": "grep *", "effect": "deny"},

    {"action": "shell", "resource": "npm *", "effect": "deny"},
    {"action": "shell", "resource": "npm run dev -- --test", "effect": "allow"},
  ],
}