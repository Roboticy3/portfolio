---
import AboutSidebar from "../components/AboutSidebar.astro";

interface Props {
  title?: string;
  description?: string;
}

const { title = "My Site", description = "Personal site and notes" } = Astro.props;
const pathname = Astro.url.pathname;

const links = [
  { href: "/", label: "Home" },
  { href: "/games/", label: "Games" },
];

const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style is:global>
      :root {
        color-scheme: light dark;
        --bg: #ffffff;
        --fg: #1f2328;
        --muted: #59636e;
        --border: #d1d9e0;
        --link: #0969da;
        --code-bg: #f6f8fa;
        --max: 50vw;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0d1117;
          --fg: #e6edf3;
          --muted: #9198a1;
          --border: #30363d;
          --link: #4493f8;
          --code-bg: #161b22;
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font: 16px/1.6 system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
        background: var(--bg);
        color: var(--fg);
      }
      a { color: var(--link); }
      img, video, iframe, embed, object, svg, canvas { max-width: 100%; }
      img { height: auto; }
      img.media-inline {
        max-height: 1em;
        width: auto;
        vertical-align: middle;
      }

      /* A paragraph of only images: each image takes a share of the line based
         on its aspect ratio, so every image ends up the same height. */
      p.media-row {
        display: flex;
        flex-wrap: nowrap;
        align-items: flex-start;
      }
      p.media-row > .media-row-item {
        flex-grow: var(--media-grow, 1);
        flex-shrink: 1;
        flex-basis: 0;
        min-width: 0;
      }
      p.media-row > img.media-row-item {
        display: block;
        width: 0;
        height: auto;
      }
      p.media-row > a.media-row-item {
        display: block;
      }
      p.media-row > a.media-row-item img {
        display: block;
        width: 100%;
        height: auto;
      }

      /* Main content stays centered; sidebar sits in the left margin/gutter. */
      .site-shell {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, var(--max)) minmax(0, 1fr);
        column-gap: 2rem;
        align-items: start;
        padding: 0 1rem;
      }
      .about-sidebar {
        grid-column: 1;
        justify-self: stretch;
        padding-top: 1.25rem;
        /*position: sticky;*/
        top: 0;
      }
      .content-area {
        grid-column: 2;
        min-width: 0;
      }

      .about-card {
        padding-left: 1rem;
        border-left: 3px solid var(--border);
        font-size: 0.9rem;
      }
      .sidebar-content :first-child { margin-top: 0; }
      .sidebar-content :last-child { margin-bottom: 0; }
      .sidebar-content p { margin: 0 0 0.75rem; }
      .sidebar-content :where(img, video, iframe, embed, object) {
        max-width: 100%;
      }
      .sidebar-content img {
        height: auto;
        border: 1px solid var(--border);
      }
      .sidebar-content img.media-block {
        width: 100%;
        display: block;
        margin-bottom: 0.75rem;
      }

      header, main {
        max-width: var(--max);
        margin: 0 auto;
      }
      header {
        padding-top: 1.25rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--border);
      }
      nav { display: flex; gap: 1rem; flex-wrap: wrap; }
      nav a { color: var(--link); text-decoration: none; font-weight: 500; }
      nav a[aria-current="page"] { color: var(--fg); text-decoration: underline; }
      main { padding-top: 1.5rem; padding-bottom: 3rem; }

      pre {
        padding: 1rem;
        overflow: auto;
        background: var(--code-bg);
        border: 1px solid var(--border);
        border-radius: 6px;
      }
      code { font-family: ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", Menlo, monospace; }
      :not(pre) > code {
        padding: 0.15em 0.35em;
        background: var(--code-bg);
        border: 1px solid var(--border);
        border-radius: 4px;
        font-size: 0.9em;
      }
      blockquote {
        margin: 1rem 0;
        padding: 0 1rem;
        color: var(--muted);
        border-left: 4px solid var(--border);
      }
      table { border-collapse: collapse; width: 100%; }
      th, td { border: 1px solid var(--border); padding: 0.5rem 0.75rem; text-align: left; }
      hr { border: 0; border-top: 1px solid var(--border); margin: 2rem 0; }
      .embed {
        margin: 1rem 0;
        aspect-ratio: 16 / 9;
      }
      .embed iframe {
        width: 100%;
        height: 100%;
        border: 0;
        display: block;
      }
      figure { margin: 1rem 0; }
      figcaption { color: var(--muted); font-size: 0.9rem; margin-top: 0.35rem; }

      .rotate-media { margin: 1rem 0; }
      .rotate-option { display: none; }
      .rotate-option.is-active { display: block; }

      @media (max-width: 1100px) {
        .site-shell {
          grid-template-columns: 1fr;
          column-gap: 0;
        }
        .about-sidebar {
          grid-column: 1;
          justify-self: stretch;
          width: auto;
          max-width: var(--max);
          margin: 0 auto;
          position: static;
          padding-top: 1rem;
        }
        .content-area { grid-column: 1; }
      }
    </style>
    <noscript>
      <style>
        .rotate-option:first-child { display: block; }
      </style>
    </noscript>
  </head>
  <body>
    <div class="site-shell">
      <AboutSidebar />
      <div class="content-area">
        <header>
          <nav aria-label="Main">
            {links.map((link) => (
              <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>
                {link.label}
              </a>
            ))}
          </nav>
        </header>
        <main>
          <slot />
        </main>
      </div>
    </div>
    <script>
      const randomIndex = (length) => {
        if (globalThis.crypto?.getRandomValues) {
          const value = new Uint32Array(1);
          crypto.getRandomValues(value);
          return value[0] % length;
        }

        return Math.floor(Math.random() * length);
      };

      const pickRotateMedia = () => {
        document.querySelectorAll("[data-rotate]").forEach((container) => {
          const options = Array.from(container.children).filter((element) =>
            element.hasAttribute("data-rotate-option"),
          );

          if (options.length === 0) return;

          options[randomIndex(options.length)].classList.add("is-active");
        });
      };

      const imageFor = (item) =>
        item.matches("img") ? item : item.querySelector("img");

      const sizeMediaRows = () => {
        document.querySelectorAll("p.media-row").forEach((row) => {
          const items = Array.from(row.children).filter((item) =>
            item.classList.contains("media-row-item"),
          );
          if (items.length === 0) return;

          const update = () => {
            const ratios = items.map((item) => {
              const image = imageFor(item);
              if (!image?.naturalWidth || !image.naturalHeight) return null;
              return image.naturalWidth / image.naturalHeight;
            });

            // Wait until every image in the row has loaded before dividing up
            // the width, otherwise the proportions would be based on a
            // partially loaded row.
            if (ratios.some((ratio) => ratio === null)) return;

            items.forEach((item, index) => {
              item.style.setProperty("--media-grow", String(ratios[index]));
            });
          };

          for (const item of items) {
            imageFor(item)?.addEventListener("load", update);
          }
          update();
        });
      };

      const setupMedia = () => {
        pickRotateMedia();
        sizeMediaRows();
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", setupMedia, { once: true });
      } else {
        setupMedia();
      }
    </script>
  </body>
</html>
