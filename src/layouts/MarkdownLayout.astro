---
import BaseLayout from "./BaseLayout.astro";
import SectionEntries from "../components/SectionEntries.astro";

const { frontmatter } = Astro.props;
const title = frontmatter?.title ?? "Untitled";
const description = frontmatter?.description;
const showEntries = frontmatter?.entries !== false;
---

<BaseLayout title={title} description={description}>
  {frontmatter?.title && <h1>{frontmatter.title}</h1>}
  {frontmatter?.date && <p><small><time>{frontmatter.date}</time></small></p>}
  <article>
    <slot />
  </article>
  {showEntries && <SectionEntries pathname={Astro.url.pathname} />}
</BaseLayout>
